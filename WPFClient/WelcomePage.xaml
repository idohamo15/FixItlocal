<Page x:Class="WPFClient.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFClient"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="WelcomePage"
      FlowDirection="RightToLeft"
      Background="#1E293B">

    <Page.Resources>
        <!-- סגנון מודרני לשדות הקלט -->
        <Style x:Key="ModernInputStyle" TargetType="Control">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- סגנון וכפתור מעוצב עם אפקט מעבר עכבר -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- כרטיסיית ההתחברות המרכזית -->
        <Border Width="460" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Background="White" 
                CornerRadius="16" 
                Padding="40,35">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.2" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <!-- לוגו וכותרת -->
                <StackPanel Margin="0,0,0,25" HorizontalAlignment="Center">
                    <Border Background="#ECFDF5" CornerRadius="12" Width="55" Height="55" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🔧" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="FixItLocal" FontSize="28" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock Text="ברוכים הבאים! אנא התחברו לחשבונכם" FontSize="14" Foreground="#64748B" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- שדות קלט -->
                <StackPanel Margin="0,0,0,25">
                    <TextBlock Text="אימייל:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Foreground="#334155"/>
                    <TextBox x:Name="txtEmail" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,16"/>

                    <TextBlock Text="סיסמה:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Foreground="#334155"/>
                    <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernInputStyle}"/>
                </StackPanel>

                <!-- כפתור התחברות -->
                <Button Content="התחבר" 
                        Style="{StaticResource ModernButtonStyle}" 
                        Click="LoginBtn_Click"
                        x:Name="LoginBtn"
                        Margin="0,0,0,20"/>

                <!-- מעבר להרשמה -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="אין לך חשבון? " Foreground="#64748B" FontSize="14"/>
                    <Button Content="הירשם עכשיו!" 
                            x:Name="RegisterBtn"
                            Click="RegisterBtn_Click"
                            Foreground="#2563EB" 
                            FontWeight="Bold" 
                            FontSize="14" 
                            Cursor="Hand" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>